{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["iad1"],
  "functions": {
    "app/main.py": {"maxDuration": 300}
  },
  "crons": [{"path": "/_internal/maintenance", "schedule": "0 5 * * *"}],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"}]}
  ]
}
